          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brown"
          }
        }
      }
    },
    "settings.buttons_switches_and_highlights_monochrome" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasten, Schalter und Hervorhebungen. Monochrom hält Shirox schwarz-weiß; die Farben passen sich an den hellen und dunklen Modus an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buttons, switches and highlights. Monochrome keeps Shirox black and white; the colors adjust themselves to light and dark mode."
          }
        }
      }
    },
