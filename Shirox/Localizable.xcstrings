    "settings.mpv_plays_more_formats_like" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MPV spielt mehr Formate wie MKV und mehr Untertitelstile ab. AirPlay verlagert die Wiedergabe auf Nativ oder sendet nur den Ton, wenn Nativ sie nicht abspielen kann. Nativ wechselt von selbst zu MPV, wenn es etwas nicht abspielen kann."
