          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear Temporary Files"
          }
        }
      }
    },
    "settings.clears_continue_watching_and_every" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht „Weiterschauen“ und jede Gesehen-Markierung in Folgenlisten auf diesem Gerät. AniList, MyAnimeList und Simkl bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears Continue Watching and every Watched mark in episode lists on this device. AniList, MyAnimeList and Simkl aren't changed."
          }
        }
      }
    },
    "settings.clears_cookies_website_data_the" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Cookies, Websitedaten, den Web-Cache, gelöste Cloudflare-Prüfungen und den gemerkten TMDB-Host. Die Einstellungen hier bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears cookies, website data, the web cache, solved Cloudflare checks and the remembered TMDB host. Settings here stay."
          }
        }
      }
    },
    "settings.click_the_right_side_to" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf die rechte Seite, um nach unten zu scrollen oder zur nächsten Seite zu blättern, auf die linke, um zurückzugehen; beim Lesen von rechts nach links ist es umgekehrt. Die Mitte blendet die Steuerelemente ein und aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click the right side to scroll down or turn to the next page, the left to go back; right to left reading swaps them. The middle shows and hides the controls."
          }
        }
      }
    },
    "settings.cloudflare_https_cloudflare_dns_com" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare: https://cloudflare-dns.com/dns-query unter 1.1.1.1. Google: https://dns.google/dns-query unter 8.8.8.8. Ist der Server nicht erreichbar, lädt nichts; schalte dies dann aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloudflare: https://cloudflare-dns.com/dns-query at 1.1.1.1. Google: https://dns.google/dns-query at 8.8.8.8. If the server can't be reached, nothing loads; turn this off to recover."
          }
        }
      }
    },
