    "settings.an_edit_you_make_to" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Änderung an einem Titel — Status, Fortschritt, Bewertung oder das Entfernen — wird auch in jeden anderen hier eingeschalteten Dienst geschrieben. Ausgeschaltete Dienste ändern sich nur durch die Synchronisierungen unten."
