    "settings.checks_tmdbs_api_and_images" : {
      "comment" : "AdvancedNetworkSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft die API und Bilder von TMDB, dann verschlüsseltes DNS und den Proxy, falls aktiv, und fragt Cloudflare, welche Adresse es sieht. Änderungen an DNS und Proxy gelten nach einem Neustart."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks TMDB's API and images, then encrypted DNS and the proxy if they're on, asking Cloudflare which address it sees. DNS and proxy changes apply after a restart."
          }
        }
      }
    },
