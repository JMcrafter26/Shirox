    "jellyfin.jellyfin_is_a_free_media" : {
      "comment" : "JellyfinConnectView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin ist ein kostenloser Medienserver, der auf deinem Mac, PC oder NAS läuft. Lade ihn von jellyfin.org/downloads herunter, starte ihn und schließe den Einrichtungsassistenten ab, der sich in deinem Browser öffnet. Dort legst du den Benutzernamen und das Passwort an, die du hier verwendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jellyfin is a free media server that runs on your Mac, PC or NAS. Download it from jellyfin.org/downloads, start it, and finish the setup wizard it opens in your browser. That's where you create the username and password you'll use here."
          }
        }
      }
    },
