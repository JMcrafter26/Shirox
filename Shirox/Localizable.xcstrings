    "settings.cinematic_note" : {
      "comment" : "GeneralSettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Artwork füllt das Fenster, und die Reihen der Startseite oder die Details einer Serie scrollen darüber. Schalte es aus, um auf der Startseite das Banner mit den Reihen darunter und bei einer Serie das Poster über der Folgenliste zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The artwork fills the window, with Home's rows or a show's details scrolling up over it. Turn off for Home's banner with the rows under it, and a show's poster above its episode list."
          }
        }
      }
    },
    "settings.clear_everything" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear Everything"
          }
        }
      }
    },
    "settings.clear_everything_removes_caches_the" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alles löschen“ entfernt Caches, die die App neu aufbauen kann. Dein Fortschritt bleibt erhalten, dafür gibt es ein eigenes Zurücksetzen. Websitedaten umfassen Cookies und lokalen Speicher der Modul-Scraper. Such-Aliasse speichern gemerkte Suchergebnisse und Stream-Auswahlen pro Modul. Der Netzwerk-Cache enthält gespeicherte Antworten von Websites und Diensten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear Everything removes caches the app can rebuild. It keeps your watch progress, which has its own reset. Website Data includes cookies and local storage from module scrapers. Search Aliases store remembered search results and stream picks per module. The Network Cache holds saved answers from sites and services."
          }
        }
      }
    },
    "settings.clear_local_library" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokale Mediathek löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clear Local Library"
          }
        }
      }
    },
    "settings.clear_logs" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
