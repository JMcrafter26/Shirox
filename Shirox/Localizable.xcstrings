    "jellyfin.find_address_detail_mac" : {
      "comment" : "JellyfinConnectView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist die lokale IP-Adresse des Server-Computers, gefolgt von :8096, zum Beispiel http://192.168.1.10:8096, oder http://localhost:8096, wenn er auf diesem Mac läuft. Dein Mac muss im selben Netzwerk sein. Um unterwegs zu schauen, brauchst du den eingerichteten Fernzugriff von Jellyfin oder eine Domain, die auf deinen Server zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's the server computer's local IP address followed by :8096, for example http://192.168.1.10:8096, or http://localhost:8096 when it runs on this Mac. Your Mac needs to be on the same network. To watch away from home you need Jellyfin's remote access set up, or a domain pointing at your server."
          }
        }
      }
    },
    "jellyfin.find_address_detail_phone" : {
      "comment" : "JellyfinConnectView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist die lokale IP-Adresse des Server-Computers, gefolgt von :8096, zum Beispiel http://192.168.1.10:8096. Dein Telefon muss im selben Netzwerk sein. Um unterwegs zu schauen, brauchst du den eingerichteten Fernzugriff von Jellyfin oder eine Domain, die auf deinen Server zeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's the server computer's local IP address followed by :8096, for example http://192.168.1.10:8096. Your phone needs to be on the same network. To watch away from home you need Jellyfin's remote access set up, or a domain pointing at your server."
          }
        }
      }
    },
