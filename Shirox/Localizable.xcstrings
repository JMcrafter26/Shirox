    "settings.brings_your_two_accounts_into" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringt deine beiden Konten auf denselben Stand — ein einmaliger Abgleich für alles, was du getrackt hast, bevor du dich hier angemeldet hast. Die Synchronisierung in beide Richtungen gleicht sie in einem Durchgang ab; die einseitigen Kopien schreiben nur ins Ziel. So oder so wird Fortschritt nur vorwärts übertragen, alles, was schon weiter ist, bleibt, wie es ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brings your two accounts into line — a one-time backfill for everything you tracked before signing in here. Syncing both ways reconciles them in a single pass; the one-way copies only ever write to the destination. Either way progress is only ever moved forward, so anything further along is left as it is."
          }
        }
      }
    },
    "settings.brown" : {
      "comment" : "AppAppearance",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
