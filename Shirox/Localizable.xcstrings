    "settings.download_quality" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download-Qualität"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download Quality"
          }
        }
      }
    },
    "settings.download_quality_picks_the_rendition" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Download-Qualität bestimmt die Variante bei Streams, die mehrere anbieten, sonst die nächstniedrigere. Eine geladene Folge behält die Qualität, in der sie gespeichert wurde. „Nach dem Ansehen löschen“ entfernt eine geladene Folge, sobald du sie beendest und den Player schließt. Unterbrochene oder fehlgeschlagene Downloads beim nächsten Öffnen der App erneut versuchen — standardmäßig aus, damit das Öffnen der App nie ungefragt eine große Übertragung über Mobilfunk startet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download Quality picks the rendition for streams that offer several, falling back to the closest below. A downloaded episode keeps the one it was saved in. Delete After Watching removes a downloaded episode once you finish it and close the player. Retry downloads that were interrupted or failed when the app next opens — off by default so reopening the app never starts a large transfer on cellular without you asking."
          }
        }
      }
    },
    "settings.download_settings" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download-Einstellungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download Settings"
          }
        }
      }
    },
    "settings.downloaded_episodes_and_chapters_arent" : {
      "comment" : "SettingsView",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geladene Folgen und Kapitel sind kein Cache, daher lässt „Alles löschen“ sie in Ruhe. Lösche einzelne Folgen im Downloads-Tab oder schalte „Nach dem Ansehen löschen“ in den Download-Einstellungen ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded episodes and chapters aren't a cache, so Clear Everything leaves them alone. Delete single episodes from the Downloads tab, or turn on Delete After Watching in Download Settings."
          }
        }
      }
    },
    "settings.drag_to_reorder_settings_always" : {
